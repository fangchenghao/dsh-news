{
  "name": "@fffangchenghao/dsh-news",
  "version": "0.15.2",
  "type": "module",
  "description": "为 DeepSeek Harness 与 ChatGPT 桌面版聚合 AI 信息源，按兴趣筛选并生成每日中文简报。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "desktop/",
    ".agents/plugins/marketplace.json",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CONTRACT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "author": {
    "name": "fangchenghao"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fangchenghao/dsh-news.git"
  },
  "homepage": "https://github.com/fangchenghao/dsh-news",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "rss",
    "ai-news",
    "digest"
  ],
  "scripts": {
    "test": "node --test test/host.test.mjs test/client.smoke.test.mjs test/desktop.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true
}
